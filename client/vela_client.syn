-- vela_client.syn — the command line for the other side of the enclave, on top of vela_lib.syn
-- (Vela's client protocol as a module: keys, cipher, submit, events, facilitator, reports).
-- Everything OUTSIDE the enclave that a Vela app needs: make the P-521 key, register it
-- (AssociateKey with a privacy seed), upload a `.wasm` and deploy it (with or without a trigger
-- contract), submit PROCESS / DEANONYMIZATION requests with the payload encrypted for the Executor,
-- wait for completion through the subgraph, and decrypt your events. Any payload, any app.
--
--   the public devnet (no Docker):
--   synsema run vela_client.syn -- devnet [host]                     a token of your own from devnet.synsema.app, written to .env
--   synsema run vela_client.syn -- allow-token <address>             TokenAllowlist.addAllowedToken with the signing key (the admin: Anvil #0 on a devnet)
--   synsema run vela_client.syn -- allow-authority <appId> <address> DefaultAuthority.addAllowedAuthority — an auditor for your app
--   synsema run vela_client.syn -- keys                          a fresh P-521 pair, printed for .env
--   synsema run vela_client.syn -- address                       the signing address (VELA_SECP_KEY)
--   synsema run vela_client.syn -- tee                           the Executor's P-521 key, read on-chain
--   synsema run vela_client.syn -- deploy <app.wasm> [params-json|-] [trigger-address]
--   synsema run vela_client.syn -- register                      AssociateKey: your key + encrypted seed
--   synsema run vela_client.syn -- deposit <amount> [token]      ETH (wei) or an allowlisted ERC-20 (units) into the app (the guest's `deposit`)
--   synsema run vela_client.syn -- send '<json>' [wei]           PROCESS (payload encrypted; optional deposit with it)
--   the template's ledger, spelled out (each one is a `send` / `report` with the payload built for you):
--   synsema run vela_client.syn -- transfer <to> <amount> [token|-] [invoice]   a private transfer; with an invoice, a public keccak receipt
--   synsema run vela_client.syn -- withdraw <to> <amount> [token]              a pull-payment `to` claims on-chain
--   synsema run vela_client.syn -- balance [token]                             your private balance, from your newest event
--   synsema run vela_client.syn -- public-balance [token]                      what you hold on-chain (ETH or an ERC-20)
--   synsema run vela_client.syn -- pending [token] [address]                   what a withdrawal left for you (or `address`) to claim on the ProcessorEndpoint
--   synsema run vela_client.syn -- claim [token] [address]                     collect it, for you or for `address` (claim(token, payee) on the ProcessorEndpoint: a plain transaction, anyone may send it)
--   synsema run vela_client.syn -- history <address> [from-nonce] [to-nonce]   tx_history report of one account (you must be an allowed authority)
--   synsema run vela_client.syn -- report '<json>'               DEANONYMIZATION (the caller must be an allowed authority); prints the decrypted report
--   synsema run vela_client.syn -- report-download <reportId>    fetch + decrypt an earlier report from the authority service
--   synsema run vela_client.syn -- events [n]                    your last n events, decrypted
--   synsema run vela_client.syn -- app-events [n]                the app's public events (subtype + data)
--   synsema run vela_client.syn -- status <requestId>
--   facilitator (the user signs, VELA_SECP_KEY pays gas and fee; the user needs no ETH):
--   synsema run vela_client.syn -- user | user-keys              the user's address (VELA_USER_KEY) | a fresh user key
--   synsema run vela_client.syn -- register-for                  AssociateKey for the user, submitted by the facilitator
--   synsema run vela_client.syn -- send-for '<json>' [amount token]   PROCESS for the user; an ERC-20 deposit rides on an EIP-2612 permit
--   synsema run vela_client.syn -- events-for [n]                the user's events, decrypted
--
-- Config comes from .env (copy .env.example): VELA_RPC_URL, VELA_PROCESSOR, VELA_TEE_AUTHENTICATOR,
-- VELA_AUTHORITY_URL, VELA_SUBGRAPH_URL, VELA_APP_ID, VELA_MAX_FEE (wei), VELA_SECP_KEY (hex),
-- VELA_P521_KEY (hex, 66 bytes), VELA_P521_PUB (hex, 133 bytes, uncompressed), and for the
-- facilitator commands VELA_USER_KEY (the user's secp256k1 key, hex). The wire formats are
-- documented in vela_lib.syn, next to the code that speaks them.
intent: "vela client: keys, deploy, register, encrypted requests, events, reports and the facilitator — on top of the protocol module"

require net("localhost")
require net("127.0.0.1")
require net("devnet.synsema.app")
require env("VELA_*")
require secret("VELA_*")
require sign("VELA_SECP_KEY")
require sign("VELA_USER_KEY")
require sign("VELA_ADMIN_KEY")
require random
require time
require file.read("*")
require file.write(".env")
require reveal("ecdh_keypair.private")

use "./vela_lib.syn" as v

let ETH be "0x0000000000000000000000000000000000000000"
let PROCESS be 1
let DEANONYMIZATION be 2
let ASSOCIATE_KEY be 3

task usage()
    print("usage: synsema run vela_client.syn -- devnet [host] | allow-token <address> | allow-authority <appId> <address> | keys | address | tee | deploy <wasm> [params-json|-] [trigger] | register | deposit <amount> [token] | send '<json>' [wei] | transfer <to> <amount> [token|-] [invoice] | withdraw <to> <amount> [token] | balance [token] | public-balance [token] | pending [token] [address] | claim [token] [address] | history <address> [from-nonce] [to-nonce] | report '<json>' | report-download <reportId> | events [n] | app-events [n] | status <requestId> | user | user-keys | register-for | send-for '<json>' [amount token] | events-for [n]")

task arg_or(a, i, default)
    give when length(a) > i then a[i] otherwise default

task encrypted(c, plain)
    give v.seal(v.derive_key(v.p521_key(), v.tee_public_key(c)), bytes(json_encode(plain)))

-- The ledger's public receipt of an invoiced transfer, recomputed here so you know which app event
-- to look for: keccak256(abi.encode(invoice, from, token, amount, to)) — the same line as app/app.syn.
task receipt_of(invoice, origin, token, amount, dest)
    let call be abi_encode("receipt(string,address,address,uint256,address)", [invoice, origin, token, amount, dest])
    give v.hex_of(keccak256(slice(call, 4, length(call))))

-- `transfer` and `withdraw` take the token as the third argument; "-" or nothing means ETH.
task token_arg(a, i)
    let t be lower(arg_or(a, i, ETH))
    give when t == "-" then ETH otherwise t

-- The newest of your decrypted events for a token carries the balance the enclave computed.
task balance_in(ev, token)
    try
        when contains(ev, "balance") and lower(text(ev["token"])) == token
            give ev
    recover e
        give nothing
    give nothing

-- What a withdrawal left on the ProcessorEndpoint for `who` to claim, in `token`.
task pending_of(c, token, who)
    give v.call_uint(c, v.need(c, "processor", "VELA_PROCESSOR"), "pendingClaims(address,address)", [token, who])

task run_process(c, plain)
    let id be v.submit(c, PROCESS, encrypted(c, plain), ETH, 0)
    print("request submitted: " + id)
    let row be v.wait_completed(c, id, false)
    print("completed at block " + text(row["blockNumber"]) + ", fees " + text(row["applicationFees"]) + " wei")
    give id

task run_cli(a)
    when length(a) == 0
        usage()
        give nothing
    let c be v.cfg()
    match a[0]
        is "devnet"
            let host be arg_or(a, 1, "devnet.synsema.app")
            let values be v.devnet_env(host)
            v.env_write(".env", values)
            each k in keys(values)
                print(k + "=" + text(values[k]))
            print("written to .env: a token of your own on " + host + " with an account of its own (ETH, DEPLOYER_ROLE, test tokens); allow-token / allow-authority go through its admin desk (VELA_ADMIN_URL)")
        is "allow-token"
            let receipt be v.allow_token(c, lower(a[1]))
            print("token " + lower(a[1]) + " allowlisted (tx " + text(receipt["transactionHash"]) + ")")
        is "allow-authority"
            let receipt be v.allow_authority(c, v.int_of(a[1]), lower(a[2]))
            print("authority " + lower(a[2]) + " allowed for app " + a[1] + " (tx " + text(receipt["transactionHash"]) + ")")
        is "keys"
            let kp be ecdh_keypair("P-521")
            print("VELA_P521_KEY=" + decode(reveal(kp["private"]), "hex"))
            print("VELA_P521_PUB=" + decode(kp["public"], "hex"))
        is "address"
            print(v.me())
        is "tee"
            print(v.hex_of(v.tee_public_key(c)))
        is "user"
            print(v.user_address())
        is "user-keys"
            let k be decode(random_bytes(32), "hex")
            print("VELA_USER_KEY=" + k)
            print("address " + eth_address(as_secret(k, "VELA_USER_KEY")))
        is "deploy"
            let params be when length(a) > 2 and a[2] != "-" then json_decode(a[2]) otherwise nothing
            let trigger be arg_or(a, 3, nothing)
            let ids be v.deploy(c, a[1], params, trigger)
            print("deploy submitted: app " + text(ids["app_id"]) + ", request " + ids["request_id"])
            let row be v.wait_completed(c, ids["request_id"], true)
            print("deploy completed at block " + text(row["blockNumber"]) + " — put VELA_APP_ID=" + text(ids["app_id"]) + " in .env")
        is "register"
            let id be v.submit(c, ASSOCIATE_KEY, v.register_payload(c), ETH, 0)
            print("register submitted: " + id)
            v.wait_completed(c, id, false)
            print("registered " + v.me() + " with a privacy seed (50 subtypes)")
        is "deposit"
            let token be lower(arg_or(a, 2, ETH))
            let amount be v.int_of(a[1])
            when token != ETH
                v.approve(c, token, amount)
            let id be v.submit(c, PROCESS, bytes(""), token, amount)
            print("deposit submitted: " + id)
            v.wait_completed(c, id, false)
            print("deposit completed" + (when token == ETH then "" otherwise " (" + token + ")"))
        is "send"
            let plain be json_decode(a[1])
            let wei be when length(a) > 2 then v.int_of(a[2]) otherwise 0
            let id be v.submit(c, PROCESS, encrypted(c, plain), ETH, wei)
            print("request submitted: " + id)
            let row be v.wait_completed(c, id, false)
            print("completed at block " + text(row["blockNumber"]) + ", fees " + text(row["applicationFees"]) + " wei")
        is "transfer"
            let plain be {"type": "transfer", "to": lower(a[1]), "amount": a[2]}
            let token be token_arg(a, 3)
            when token != ETH
                set plain["token"] to token
            when length(a) > 4
                set plain["invoice_id"] to a[4]
            run_process(c, plain)
            when length(a) > 4
                print("public receipt (an app event with this subtype): " + receipt_of(a[4], v.me(), token, v.int_of(a[2]), lower(a[1])))
        is "withdraw"
            let plain be {"type": "withdraw", "to": lower(a[1]), "amount": a[2]}
            let token be token_arg(a, 3)
            when token != ETH
                set plain["token"] to token
            run_process(c, plain)
            print("pending for " + lower(a[1]) + " on the ProcessorEndpoint: " + text(pending_of(c, token, lower(a[1]))) + " (`claim` collects it)")
        is "public-balance"
            let token be token_arg(a, 1)
            print(text(v.token_balance_of(c, token, v.me())) + " (" + token + ", on-chain)")
        is "pending"
            let token be token_arg(a, 1)
            let who be lower(arg_or(a, 2, v.me()))
            print(text(pending_of(c, token, who)) + " (" + token + ") pending for " + who)
        is "claim"
            let token be token_arg(a, 1)
            let who be lower(arg_or(a, 2, v.me()))
            let receipt be v.send_tx(c, v.need(c, "processor", "VELA_PROCESSOR"), 0, abi_encode("claim(address,address)", [token, who]))
            print("claimed for " + who + " (tx " + text(receipt["transactionHash"]) + "); pending now " + text(pending_of(c, token, who)) + ", on-chain " + text(v.token_balance_of(c, token, who)))
        is "balance"
            let token be token_arg(a, 1)
            let found be nothing
            each item in v.my_events(c, 50)
                when found == nothing and contains(item, "event")
                    set found to balance_in(item["event"], token)
            when found == nothing
                print("no event for " + token + " among your last 50: deposit or receive first")
            otherwise
                print(text(found["balance"]) + " (" + token + ", after nonce " + text(found["nonce"]) + ")")
        is "history"
            let plain be {"report_type": "tx_history", "address": lower(a[1])}
            when length(a) > 2
                set plain["from_nonce"] to floor(number(a[2]))
            when length(a) > 3
                set plain["to_nonce"] to floor(number(a[3]))
            let id be v.submit(c, DEANONYMIZATION, encrypted(c, plain), ETH, 0)
            print("report request submitted: " + id)
            v.wait_completed(c, id, false)
            let r be v.download_report(c, id)["report"]
            each tx in r["transactions"]
                print(json_encode(tx))
            print("balances of " + r["address"] + ": " + json_encode(r["balances"]))
        is "report"
            let plain be json_decode(arg_or(a, 1, "{}"))
            let id be v.submit(c, DEANONYMIZATION, encrypted(c, plain), ETH, 0)
            print("report request submitted: " + id)
            v.wait_completed(c, id, false)
            print("report generated: " + v.need(c, "app_id", "VELA_APP_ID") + "_" + slice(id, 2, length(id)))
            print(json_encode(v.download_report(c, id)))
        is "report-download"
            print(json_encode(v.download_report(c, a[1])))
        is "events"
            each item in v.my_events(c, floor(number(arg_or(a, 1, "10"))))
                print(json_encode(item))
        is "app-events"
            each item in v.app_events(c, floor(number(arg_or(a, 1, "10"))))
                print(json_encode(item))
        is "status"
            let row be v.completion(c, lower(a[1]), false)
            when row == nothing
                set row to v.completion(c, lower(a[1]), true)
            print(when row == nothing then "pending (not completed yet)" otherwise json_encode(row))
        is "register-for"
            let id be v.submit_for(c, ASSOCIATE_KEY, v.register_payload_for(c), ETH, 0)
            print("register submitted by the facilitator: " + id)
            v.wait_completed(c, id, false)
            print("registered " + v.user_address() + " (the user paid nothing)")
        is "send-for"
            let plain be json_decode(a[1])
            let amount be when length(a) > 2 then v.int_of(a[2]) otherwise 0
            let token be lower(arg_or(a, 3, ETH))
            let id be v.submit_for(c, PROCESS, encrypted(c, plain), token, amount)
            print("request submitted by the facilitator for " + v.user_address() + ": " + id)
            let row be v.wait_completed(c, id, false)
            print("completed at block " + text(row["blockNumber"]) + ", fees " + text(row["applicationFees"]) + " wei (paid by the facilitator)")
        is "events-for"
            each item in v.events_for(c, floor(number(arg_or(a, 1, "10"))))
                print(json_encode(item))
        otherwise
            usage()

run_cli(args())

-- ---------------------------------------------------------------------------------------
-- Tests (pure: no chain, no network): `synsema test vela_client.syn`
-- ---------------------------------------------------------------------------------------

test "decimal text becomes an exact integer beyond 2^53"
    assert_eq(text(v.int_of("9105241052143571847")), "9105241052143571847")
    assert_eq(v.int_of("100"), 100)
    assert_eq(v.int_of("0"), 0)

test "a payload round-trips through the Executor's cipher (P-521 ECDH → HKDF → AES-256-GCM)"
    let user be ecdh_keypair("P-521")
    let tee be ecdh_keypair("P-521")
    let k_user be v.derive_key(user["private"], tee["public"])
    let k_tee be v.derive_key(tee["private"], user["public"])
    let blob be v.seal(k_user, bytes("{\"type\":\"transfer\"}"))
    assert_eq(length(blob), 12 + 19 + 16)
    assert_eq(decode(v.open(k_tee, blob)), "{\"type\":\"transfer\"}")
    assert_error(() => v.open(k_tee, slice(blob, 0, 27)))

test "the seed is a 65-byte signature and yields 50 distinct 32-byte subtypes"
    let k be as_secret("ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80", "VELA_SECP_KEY")
    let s be v.seed_of(k)
    assert_eq(length(s), 65)
    assert_eq(s, v.seed_of(k))
    let subs be v.subtypes(s)
    assert_eq(length(subs), 50)
    assert_eq(length(subs[0]), 66)
    assert_eq(length(unique(subs)), 50)

test "request and deploy ids come out of the receipt logs"
    let sig_request be "0x" + decode(keccak256("RequestSubmitted(uint64,bytes32,address,address)"), "hex")
    let sig_deploy be "0x" + decode(keccak256("DeployRequestSubmitted(uint64,bytes32,address)"), "hex")
    let req be "0x" + decode(bytes([171]) + int_to_bytes(0, 31), "hex")
    let receipt be {"logs": [{"topics": ["0xdead"], "data": bytes([])}, {"topics": [sig_request, "0x" + decode(int_to_bytes(7, 32), "hex"), req, "0x" + decode(int_to_bytes(0, 32), "hex")], "data": bytes([])}]}
    assert_eq(v.request_id_of(receipt), req)
    let dep be {"logs": [{"topics": [sig_deploy, "0x" + decode(int_to_bytes(9105241052143571847, 32), "hex"), "0x" + decode(int_to_bytes(0, 32), "hex")], "data": bytes([205]) + int_to_bytes(0, 31)}]}
    let ids be v.deploy_ids_of(dep)
    assert_eq(text(ids["app_id"]), "9105241052143571847")
    assert_eq(slice(ids["request_id"], 0, 4), "0xcd")
    assert_error(() => v.request_id_of({"logs": []}))

test "a subtype reads back as its label when it is one, and as nothing when it is a hash"
    let label be "execute_requested"
    let padded be bytes(label) + int_to_bytes(0, 32 - length(bytes(label)))
    assert_eq(v.subtype_label(v.hex_of(padded)), label)
    assert_eq(v.subtype_label(v.hex_of(keccak256("INV-1"))), nothing)
    assert_eq(v.subtype_label(v.hex_of(int_to_bytes(0, 32))), nothing)

test "the facilitator's typed data digests are 32 bytes and change with every field that matters"
    let processor be "0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9"
    let user be "0x1111111111111111111111111111111111111111"
    let d1 be v.authorization_digest(31337, processor, user, 7, PROCESS, bytes("payload"), ETH, 0, 0, 1800000000)
    let d2 be v.authorization_digest(31337, processor, user, 7, PROCESS, bytes("payload"), ETH, 0, 1, 1800000000)
    let d3 be v.authorization_digest(1, processor, user, 7, PROCESS, bytes("payload"), ETH, 0, 0, 1800000000)
    assert_eq(length(d1), 32)
    assert(d1 != d2)
    assert(d1 != d3)
    assert_eq(d1, v.authorization_digest(31337, processor, user, 7, PROCESS, bytes("payload"), ETH, 0, 0, 1800000000))
    let p1 be v.permit_digest(31337, processor, "Test Token", user, processor, 1000000, 0, 1800000000)
    assert_eq(length(p1), 32)
    assert(p1 != v.permit_digest(31337, processor, "Test Token", user, processor, 1000000, 1, 1800000000))
    let k be as_secret("ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80", "VELA_USER_KEY")
    let sig be v.eth_signature(d1, k)
    assert_eq(length(sig), 65)
    assert(sig[64] == 27 or sig[64] == 28)
    assert_eq(length(v.permit_bytes(sig)), 96)
    assert_eq(v.permit_bytes(sig)[31], sig[64])

test "the invoice receipt is the ledger's keccak of abi.encode(invoice, from, token, amount, to); the token argument defaults to ETH"
    let alice be "0x1111111111111111111111111111111111111111"
    let bob be "0x2222222222222222222222222222222222222222"
    let r be receipt_of("INV-2026-1", alice, ETH, 120, bob)
    assert_eq(length(r), 66)
    assert_eq(r, receipt_of("INV-2026-1", alice, ETH, 120, bob))
    assert(r != receipt_of("INV-2026-1", alice, ETH, 121, bob))
    assert_eq(r, v.hex_of(keccak256(slice(abi_encode("x(string,address,address,uint256,address)", ["INV-2026-1", alice, ETH, 120, bob]), 4, 4 + 224))))
    assert_eq(token_arg(["transfer", bob, "5"], 3), ETH)
    assert_eq(token_arg(["transfer", bob, "5", "-"], 3), ETH)
    assert_eq(token_arg(["transfer", bob, "5", "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"], 3), "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48")
    assert_eq(balance_in({"type": "deposit", "token": ETH, "balance": "7", "nonce": 1}, ETH)["balance"], "7")
    assert_eq(balance_in({"type": "deposit", "token": ETH, "balance": "7", "nonce": 1}, "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48"), nothing)
    assert_eq(balance_in("not json", ETH), nothing)

test "submitRequest calldata carries the selector"
    let data be abi_encode("submitRequest(uint8,uint64,uint8,bytes,address,uint256,uint256)", [0, 1, PROCESS, bytes("x"), ETH, 5, 100])
    assert_eq(slice(data, 0, 4), abi_selector("submitRequest(uint8,uint64,uint8,bytes,address,uint256,uint256)"))
